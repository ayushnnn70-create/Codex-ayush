<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Universe Travel | Disha Rana & Ayush Rana</title>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-dark: #0a0d14;
      --text-main: #ffffff;
      --text-muted: #8b92a5;
      --accent-blue: #4a78a6;
      --glow-red: rgba(255, 77, 77, 0.8);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Inter', sans-serif;
      background-color: var(--bg-dark);
      color: var(--text-main);
      display: flex;
      height: 100vh;
      overflow: hidden; /* Body scroll lock */
    }

    /* Left Side - Fixed Image Section */
    .left-pane {
      width: 50%;
      height: 100vh;
      position: relative;
      background: url('https://images.unsplash.com/photo-1446776811953-b23d57bd21aa?q=80&w=1400&auto=format&fit=crop') center/cover no-repeat;
    }

    .logo-box {
      position: absolute;
      top: 40px;
      left: 40px;
      width: 45px;
      height: 45px;
      background: white;
      color: black;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Outfit', sans-serif;
      font-weight: 500;
      font-size: 15px;
      letter-spacing: 1px;
      box-shadow: 0 0 20px rgba(255,255,255,0.2);
    }

    .vertical-social {
      position: absolute;
      left: 20px;
      top: 50%;
      transform: translateY(-50%) rotate(-90deg);
      display: flex;
      gap: 30px;
      font-size: 11px;
      letter-spacing: 2px;
      color: white;
      text-transform: uppercase;
    }

    .vertical-social span {
      opacity: 0.5;
      transition: opacity 0.3s;
      cursor: pointer;
    }
    .vertical-social span:hover { opacity: 1; }

    .blue-frame {
      position: absolute;
      top: 50%;
      right: -40px;
      transform: translateY(-50%);
      width: 180px;
      height: 380px;
      border: 3px solid var(--accent-blue);
      z-index: 10;
      box-shadow: inset 0 0 20px rgba(74, 120, 166, 0.2);
    }

    /* Right Side - Scrollable Content Section */
    .right-pane {
      width: 50%;
      height: 100vh;
      padding: 40px 80px;
      display: flex;
      flex-direction: column;
      position: relative;
      background-color: var(--bg-dark);
      overflow-y: auto; /* Advanced Scrolling enabled */
      scroll-behavior: smooth;
    }

    /* Hide ugly scrollbars for a premium look */
    .right-pane::-webkit-scrollbar {
      width: 4px;
    }
    .right-pane::-webkit-scrollbar-track {
      background: var(--bg-dark);
    }
    .right-pane::-webkit-scrollbar-thumb {
      background: rgba(255,255,255,0.1);
      border-radius: 10px;
    }

    nav {
      display: flex;
      justify-content: flex-end;
      gap: 40px;
      font-size: 12px;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 80px; /* Space before content starts */
    }
    nav a {
      color: var(--text-muted);
      text-decoration: none;
      transition: all 0.3s ease;
    }
    nav a:hover {
      color: var(--text-main);
      text-shadow: 0 0 10px rgba(255,255,255,0.5);
    }

    .content-wrapper {
      max-width: 500px;
      position: relative;
    }

    .schrodinger {
      font-size: 14px;
      color: var(--accent-blue);
      opacity: 0.6;
      letter-spacing: 3px;
      font-family: monospace;
      margin-bottom: 20px;
      display: block;
    }

    h1 {
      font-family: 'Outfit', sans-serif;
      font-size: 5rem;
      font-weight: 300;
      line-height: 1.05;
      margin-bottom: 40px;
    }
    h1 span.dash {
      display: inline-block;
      width: 70px;
      height: 2px;
      background: white;
      vertical-align: middle;
      margin-right: 15px;
    }

    /* Advanced Description Typography */
    .advanced-text {
      font-size: 14px;
      color: var(--text-muted);
      line-height: 1.9;
      text-align: justify;
      margin-bottom: 40px;
    }
    .advanced-text p {
      margin-bottom: 20px;
    }
    .highlight {
      color: var(--text-main);
      font-weight: 400;
      letter-spacing: 0.5px;
    }

    /* Unique Date Section (High-Tech Design) */
    .unique-date-box {
      margin-top: 50px;
      margin-bottom: 60px;
      padding: 25px;
      border: 1px solid rgba(255,255,255,0.05);
      border-radius: 4px;
      background: linear-gradient(145deg, rgba(255,255,255,0.02) 0%, rgba(0,0,0,0) 100%);
      position: relative;
      overflow: hidden;
    }
    .unique-date-box::before {
      content: '';
      position: absolute;
      top: 0; left: 0;
      width: 2px; height: 100%;
      background: var(--accent-blue);
      box-shadow: 0 0 15px var(--accent-blue);
    }
    .date-row {
      display: flex;
      justify-content: space-between;
      font-family: monospace;
      font-size: 13px;
      color: var(--accent-blue);
      letter-spacing: 2px;
    }
    .unique-label {
      text-align: center;
      margin-top: 20px;
      padding-top: 20px;
      border-top: 1px dashed rgba(255,255,255,0.1);
      font-family: 'Outfit', sans-serif;
      font-size: 13px;
      color: var(--text-main);
      letter-spacing: 6px;
      text-transform: uppercase;
      text-shadow: 0 0 8px rgba(255,255,255,0.3);
    }

    /* Auth & Admin System */
    .auth-section {
      border-top: 1px solid rgba(255,255,255,0.08);
      padding-top: 30px;
      margin-bottom: 40px;
    }
    .btn {
      display: inline-block;
      padding: 10px 22px;
      background: transparent;
      border: 1px solid var(--text-muted);
      color: var(--text-main);
      text-decoration: none;
      font-size: 12px;
      border-radius: 2px;
      cursor: pointer;
      text-transform: uppercase;
      letter-spacing: 1px;
      transition: 0.3s;
    }
    .btn:hover { border-color: white; background: rgba(255,255,255,0.05); }
    
    textarea {
      width: 100%;
      height: 80px;
      background: rgba(0,0,0,0.2);
      border: 1px solid rgba(255,255,255,0.1);
      color: white;
      padding: 15px;
      font-size: 13px;
      margin-bottom: 15px;
      outline: none;
      font-family: inherit;
    }
    textarea:focus { border-color: var(--accent-blue); }

    .footer-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 30px;
      padding-bottom: 60px; /* Space at the very bottom */
    }
    .footer-col h6 {
      font-size: 10px;
      color: var(--text-muted);
      letter-spacing: 3px;
      margin-bottom: 12px;
      text-transform: uppercase;
    }
    .footer-col p {
      font-size: 12px;
      color: var(--text-main);
      line-height: 1.6;
      opacity: 0.8;
    }

    /* Mobile Responsive */
    @media (max-width: 900px) {
      body { flex-direction: column; overflow-y: auto; height: auto; }
      .left-pane { width: 100%; height: 50vh; position: relative; }
      .right-pane { width: 100%; height: auto; padding: 40px 20px; overflow-y: visible; }
      .blue-frame { display: none; }
      h1 { font-size: 3.5rem; }
      .date-row { flex-direction: column; gap: 15px; text-align: center; }
    }
  </style>
</head>
<body>

  <!-- Fixed Left Image Section -->
  <div class="left-pane">
    <div class="logo-box">DR</div>
    <div class="vertical-social">
      <span>Twitter</span>
      <span>Instagram</span>
    </div>
    <div class="blue-frame"></div>
  </div>

  <!-- Scrollable Right Content Section -->
  <div class="right-pane">
    <nav>
      <a href="#">System</a>
      <a href="#">Telemetry</a>
      <a href="#">Coordinates</a>
      <a href="#">Secure Comm</a>
    </nav>

    <div class="content-wrapper">
      <span class="schrodinger">iℏ ∂/∂t Ψ(r,t) = Ĥ Ψ(r,t)</span>
      
      <h1>Universe<br><span class="dash"></span> travel</h1>
      
      <!-- Highly Advanced Scrollable Description -->
      <div class="advanced-text">
        <p>
          Navigating the cosmos requires more than conventional propulsion; it demands an absolute understanding of the fabric of space-time. By manipulating <span class="highlight">quantum entanglement</span> and macroscopic gravitational fields, we calculate trajectories through the interstellar medium that were previously theorized as mathematically impossible.
        </p>
        <p>
          As our vessels traverse dense nebulae and monitor <span class="highlight">blackbody absorption metrics</span> near the event horizon, our on-board computing continuously analyzes electric flux and non-linear differential equations. This ensures our kinetic shielding remains intact against extreme cosmic radiation and operator liquidity traps hidden in deep space sectors.
        </p>
        <p>
          This is not merely a physical journey. It is a traversal across theoretical dimensions, bridging the gap between absolute calculus and the physical reality of the solar system.
        </p>
        
        <!-- Live Admin Data from App -->
        <p style="margin-top: 25px; border-left: 2px solid var(--accent-blue); padding-left: 15px; color: white;">
          <em>Live Transmission:</em> <%= content %>
        </p>
      </div>

      <!-- User Authentication & Admin Edit -->
      <div class="auth-section">
        <% if (user) { %>
          <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 20px;">
            <% if (user.photos && user.photos[0]) { %>
              <img src="<%= user.photos[0].value %>" alt="Profile" style="width: 35px; height: 35px; border-radius: 50%; border: 1px solid var(--accent-blue);">
            <% } %>
            <p style="font-size: 13px; color: var(--text-muted); letter-spacing: 1px;">Access Granted: <span style="color: white;"><%= user.displayName %></span></p>
            <a href="/logout" class="btn" style="padding: 6px 12px; border-color: rgba(255,77,77,0.5); color: #ff4d4d; font-size: 10px;">Terminate Session</a>
          </div>

          <% if (isAdmin) { %>
            <form action="/update" method="POST">
              <textarea name="newContent" placeholder="Enter new operational coordinates or broadcast..."><%= content %></textarea>
              <button type="submit" class="btn" style="border-color: var(--accent-blue); color: var(--accent-blue);">Update System Grid</button>
            </form>
          <% } %>
        <% } else { %>
          <a href="/auth/google" class="btn">Initialize Override (Sign In)</a>
        <% } %>
      </div>

      <!-- The Unique Date Section you requested -->
      <div class="unique-date-box">
        <div class="date-row">
          <span>ORIGIN: 26 APRIL</span>
          <span>ECLIPSE: 13 SEPTEMBER</span>
        </div>
        <div class="unique-label">
          — Unique Date —
        </div>
      </div>

      <!-- Final Footer Information -->
      <div class="footer-grid">
        <div class="footer-col">
          <h6>COMMANDER / OWNER</h6>
          <p>Disha Rana<br>Sector 25.240<br>Deep Space HQ</p>
        </div>
        <div class="footer-col">
          <h6>SYSTEM CO-OWNER</h6>
          <p>Ayush Rana<br>T. +0095 5176 6598<br>E. zuxislive@gmail.com</p>
        </div>
      </div>

    </div>
  </div>

</body>
</html>
