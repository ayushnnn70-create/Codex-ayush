h1{font-family:Manrope,sans-serif;font-size:clamp(2.2rem,5vw,4.6rem);line-height:.98;letter-spacing:-2px;margin-bottom:18px}.gradient{background:linear-gradient(90deg,#fff,var(--cyan),#9c8cff);-webkit-background-clip:text;color:transparent}
.lead{max-width:760px;color:#c0ccdc;line-height:1.75;font-size:14px}
.controls{display:flex;gap:10px;margin-top:25px;flex-wrap:wrap}input{flex:1;min-width:220px;background:rgba(0,0,0,.35);border:1px solid var(--line);color:#fff;padding:13px 15px;border-radius:4px;outline:none}input:focus{border-color:rgba(115,217,255,.65)}button{background:rgba(115,217,255,.08);border:1px solid var(--line);color:#dcecff;padding:11px 15px;border-radius:4px;cursor:pointer}button:hover{background:rgba(115,217,255,.16)}
.stats{display:flex;gap:9px;flex-wrap:wrap;margin-top:15px}.stat{font-size:11px;color:#b9c6d8;padding:7px 10px;border:1px solid var(--line);background:rgba(255,255,255,.025)}
.content{padding:34px 42px 60px}.introbox{padding:20px;border:1px solid var(--line);background:linear-gradient(135deg,rgba(91,140,255,.08),rgba(164,124,255,.06));margin-bottom:30px}.introbox h2{font:700 18px Manrope;margin-bottom:10px}.introbox p{color:var(--muted);line-height:1.7;font-size:14px}
.divider{margin:45px 0 18px;display:flex;align-items:center;gap:15px}.divider h2{font:700 18px Manrope;letter-spacing:.3px}.divider span{font-size:10px;color:var(--cyan);letter-spacing:2px}
.knowledge-card{border:1px solid var(--line);background:rgba(5,10,19,.64);margin:12px 0;border-radius:3px;overflow:hidden;transition:.2s}.knowledge-card:hover{border-color:rgba(115,217,255,.34)}.card-head{display:flex;align-items:center;gap:14px;padding:17px 18px;cursor:pointer;background:rgba(255,255,255,.018)}.section-no{font:700 11px Manrope;color:var(--cyan);min-width:32px}.card-head h3{font:700 15px Manrope;flex:1;letter-spacing:.2px}.chevron{color:#8798af;transition:.2s}.knowledge-card.open .chevron{transform:rotate(180deg)}.card-body{display:none;padding:3px 22px 22px;border-top:1px solid rgba(145,190,255,.1)}.knowledge-card.open .card-body{display:block}.card-body p,.card-body li{color:#b6c3d5;font-size:13px;line-height:1.7}.card-body p{margin:10px 0}.card-body ul{padding-left:20px;margin:10px 0}.card-body li{margin:5px 0}.card-body h4{font:600 12px Manrope;color:var(--cyan);letter-spacing:1px;text-transform:uppercase;margin:20px 0 8px}.topic{padding:11px 0;border-bottom:1px solid rgba(145,190,255,.08)}.topic:last-child{border-bottom:0}.topic-name{font-weight:600;font-size:13px;color:#edf5ff;display:flex;gap:10px;align-items:flex-start}.topic-num{font-family:monospace;color:var(--cyan);font-size:11px;min-width:20px}.topic p{margin:5px 0 0 30px}
footer{padding:25px 42px;border-top:1px solid var(--line);color:#7f8da2;font-size:11px;text-align:center;letter-spacing:.4px}
.auth{margin-top:22px;padding:15px;border:1px solid var(--line);background:rgba(0,0,0,.25);font-size:12px;color:var(--muted)}.auth strong{color:#fff}.auth a{color:var(--cyan)}
@media(max-width:900px){.shell{padding:0}.panel{width:100%;border-radius:0;min-height:100vh}.top{padding:25px 20px 20px}.content{padding:25px 20px 45px}footer{padding:22px 20px}nav{justify-content:flex-start}}
