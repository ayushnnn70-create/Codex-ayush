        title: "The 12 Big Questions & 1% Physics Derivation Challenges",
        topics: [
            { title: "1. Quantum-Gravity Unification Challenge", theory: "Derive a non-divergent quantum stress-energy tensor $T_{\\mu\\nu}$ compatible with Einstein curvature.", failure: "Ultraviolet divergence at Planck scale ($10^{19}$ GeV)." },
            { title: "2. The Measurement Problem & Wavefunction Collapse", theory: "Determine if collapse is objective (GRW), decoherence-driven, or multi-branching (Many-Worlds).", failure: "No experimental distinction yet possible between quantum interpretations." }
        ]
    }
];

function renderAtlas() {
    const container = document.getElementById('atlasContent');
    container.innerHTML = '';

    atlasData.forEach((section, index) => {
        const card = document.createElement('article');
        card.className = 'knowledge-card';
        card.id = `section-${index}`;

        let topicsHTML = '';
        section.topics.forEach(t => {
            topicsHTML += `
                <div class="sub-topic">
                    <h4 class="sub-title">${t.title}</h4>
                    <div class="theory-box">
                        <span class="theory-title">Detailed Theory & Intuition</span>
                        ${t.theory}
                    </div>
                    <div class="failure-box">
                        <span class="failure-title">Limitations & Boundaries</span>
                        ${t.failure}
                    </div>
                </div>
            `;
        });

        card.innerHTML = `
            <div class="card-head" onclick="toggleCard(this)">
                <span class="section-no">${section.no}</span>
                <h3>${section.title}</h3>
                <span class="chevron">▼</span>
            </div>
            <div class="card-body">
                ${topicsHTML}
            </div>
        `;
        container.appendChild(card);
    });

    // Re-render MathJax after inserting HTML
    if (window.MathJax) {
        MathJax.typesetPromise();
    }
}

function toggleCard(head) {
    const card = head.parentElement;
    card.classList.toggle('open');
}

function toggleAll(open) {
    const cards = document.querySelectorAll('.knowledge-card');
    cards.forEach(card => {
        if (open) card.classList.add('open');
        else card.classList.remove('open');
    });
}

function filterAtlas() {
    const query = document.getElementById('searchInput').value.toLowerCase();
    const cards = document.querySelectorAll('.knowledge-card');

    cards.forEach(card => {
        const text = card.innerText.toLowerCase();
        if (text.includes(query)) {
            card.style.display = 'block';
            if (query.length > 2) card.classList.add('open');
        } else {
            card.style.display = 'none';
        }
    });
}

// Initial Render
renderAtlas();
</script>

</body>
</html>

