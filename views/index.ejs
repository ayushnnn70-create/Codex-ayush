<script>
const cards=[...document.querySelectorAll('.knowledge-card')];
cards.forEach(card=>card.querySelector('.card-head').addEventListener('click',()=>card.classList.toggle('open')));
document.getElementById('expand').onclick=()=>cards.forEach(c=>c.classList.add('open'));
document.getElementById('collapse').onclick=()=>cards.forEach(c=>c.classList.remove('open'));
const search=document.getElementById('search');
search.addEventListener('input',()=>{const q=search.value.trim().toLowerCase();cards.forEach(c=>{const hit=!q||c.innerText.toLowerCase().includes(q);c.style.display=hit?'block':'none';if(q&&hit)c.classList.add('open')})});
</script>
