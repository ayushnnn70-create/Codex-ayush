<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Technical Portfolio & Admin Hub</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      scroll-behavior: smooth;
    }
    body {
      font-family: 'Inter', sans-serif;
      background-color: #0a0e17;
      color: #e2e8f0;
      line-height: 1.6;
    }
    nav {
      position: fixed;
      top: 0;
      width: 100%;
      background: rgba(15, 23, 42, 0.9);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid #1e293b;
      padding: 15px 30px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 1000;
    }
    .logo {
      font-weight: 700;
      font-size: 1.2rem;
      color: #38bdf8;
      font-family: 'Fira Code', monospace;
    }
    .nav-links a {
      color: #94a3b8;
      text-decoration: none;
      margin-left: 20px;
      transition: color 0.3s;
    }
    .nav-links a:hover {
      color: #38bdf8;
    }
    .container {
      max-width: 900px;
      margin: 100px auto 40px;
      padding: 0 20px;
    }
    .section {
      background: #111827;
      border: 1px solid #1f2937;
      border-radius: 12px;
      padding: 30px;
      margin-bottom: 30px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.3);
    }
    h1, h2, h3 {
      color: #f8fafc;
      margin-bottom: 15px;
    }
    .user-profile {
      display: flex;
      align-items: center;
      gap: 20px;
      margin-top: 15px;
    }
    .user-profile img {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      border: 2px solid #38bdf8;
      object-fit: cover;
    }
    .btn {
      display: inline-block;
      padding: 10px 20px;
      border-radius: 6px;
      text-decoration: none;
      font-weight: 600;
      cursor: pointer;
      border: none;
      transition: opacity 0.2s;
    }
    .btn-login { background: #38bdf8; color: #0f172a; }
    .btn-logout { background: #ef4444; color: white; }
    .btn-save { background: #10b981; color: white; margin-top: 10px; }
    .btn:hover { opacity: 0.9; }
    textarea {
      width: 100%;
      height: 120px;
      background: #0f172a;
      border: 1px solid #334155;
      color: #f8fafc;
      padding: 12px;
      border-radius: 8px;
      font-family: inherit;
      resize: vertical;
    }
    .tech-links {
      display: flex;
      gap: 15px;
      flex-wrap: wrap;
      margin-top: 15px;
    }
    .tech-card {
      flex: 1;
      min-width: 200px;
      background: #1e293b;
      padding: 15px;
      border-radius: 8px;
      text-align: center;
      text-decoration: none;
      color: #38bdf8;
      border: 1px solid #334155;
      transition: transform 0.2s;
    }
    .tech-card:hover {
      transform: translateY(-3px);
    }
  </style>
</head>
<body>

  <nav>
    <div class="logo">&lt;CodexAyush /&gt;</div>
    <div class="nav-links">
      <a href="#home">Home</a>
      <a href="#about">About</a>
      <a href="#links">Socials</a>
      <% if (isAdmin) { %><a href="#admin">Admin Area</a><% } %>
    </div>
  </nav>

  <div class="container">
    
    <!-- Hero / Auth Section -->
    <section id="home" class="section">
      <h1>Developer Workspace</h1>
      <% if (user) { %>
        <div class="user-profile">
          <% if (user.photos && user.photos[0]) { %>
            <img src="<%= user.photos[0].value %>" alt="Profile">
          <% } %>
          <div>
            <h2>Welcome, <%= user.displayName %>!</h2>
            <p style="color: #10b981;">● Account Active</p>
            <a href="/logout" class="btn btn-logout" style="margin-top: 10px;">Logout</a>
          </div>
        </div>
      <% } else { %>
        <p style="margin-bottom: 20px; color: #94a3b8;">Sign in to access admin tools or verify identity.</p>
        <a href="/auth/google" class="btn btn-login">Sign in with Google</a>
      <% } %>
    </section>

    <!-- Admin Panel (Visible Only to Admin) -->
    <% if (isAdmin) { %>
      <section id="admin" class="section" style="border-color: #38bdf8;">
        <h3>⚡ Admin Console (Dynamic Editor)</h3>
        <p style="color: #94a3b8; font-size: 0.9rem; margin-bottom: 10px;">Only you can edit this content in real time.</p>
        <form action="/update" method="POST">
          <textarea name="newContent"><%= content %></textarea>
          <button type="submit" class="btn btn-save">Publish Changes</button>
        </form>
      </section>
    <% } %>

    <!-- Live Dynamic Content Section -->
    <section id="about" class="section">
      <h3>🚀 Announcement & Status</h3>
      <div style="background: #0f172a; padding: 15px; border-radius: 8px; font-family: 'Fira Code', monospace; color: #38bdf8;">
        <%= content %>
      </div>
    </section>

    <!-- Social & Project Links Section -->
    <section id="links" class="section">
      <h3>🌐 Developer Links</h3>
      <div class="tech-links">
        <a href="https://github.com/ayushnnn70-create" target="_blank" class="tech-card">GitHub Profile</a>
        <a href="#" class="tech-card">Projects Showcase</a>
        <a href="#" class="tech-card">Contact Admin</a>
      </div>
    </section>

  </div>

</body>
</html>
