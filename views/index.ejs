.chevron { color: var(--muted); font-size: 18px; transition: 0.3s; }
.knowledge-card.open .chevron { transform: rotate(180deg); color: var(--cyan); }

.card-body { display: none; padding: 30px; border-top: 1px solid var(--panel-border); background: rgba(3, 6, 12, 0.95); }
.knowledge-card.open .card-body { display: block; }

.sub-topic { margin-bottom: 30px; padding-bottom: 25px; border-bottom: 1px dashed var(--panel-border); }
.sub-topic:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
.sub-title { font-size: 18px; color: var(--cyan); font-family: Manrope; margin-bottom: 12px; font-weight: 700; display: flex; align-items: center; gap: 10px; }

.theory-box { background: rgba(91, 140, 255, 0.05); padding: 18px; border-left: 4px solid var(--blue); border-radius: 0 6px 6px 0; margin-bottom: 12px; line-height: 1.8; font-size: 14px; color: #d0deee; }
.theory-title { font-weight: 700; color: var(--blue); margin-bottom: 4px; display: block; text-transform: uppercase; font-size: 11px; letter-spacing: 1px; }

