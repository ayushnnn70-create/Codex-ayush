.panel { width: min(1200px, 96vw); background: var(--panel); border: 1px solid var(--panel-border); box-shadow: 0 30px 90px rgba(0,0,0,.8); backdrop-filter: blur(20px); border-radius: 12px; overflow: hidden; }

