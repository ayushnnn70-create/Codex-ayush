<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Space-X Tech Hub | Owner Disha Rana & Ayush Rana</title>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;800&family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      scroll-behavior: smooth;
    }
    body {
      font-family: 'Rajdhani', sans-serif;
      background-color: #000;
      color: #e2e8f0;
      overflow-x: hidden;
    }
    #canvas-container {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      z-index: -1;
    }
    nav {
      position: fixed;
      top: 0;
      width: 100%;
      background: rgba(5, 11, 24, 0.7);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(56, 189, 248, 0.2);
      padding: 15px 30px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 1000;
    }
    .logo {
      font-family: 'Orbitron', sans-serif;
      font-weight: 800;
      font-size: 1.2rem;
      color: #00f0ff;
      text-shadow: 0 0 10px rgba(0, 240, 255, 0.5);
    }
    .nav-links a {
      color: #94a3b8;
      text-decoration: none;
      margin-left: 20px;
      font-weight: 600;
      transition: all 0.3s;
    }
    .nav-links a:hover {
      color: #00f0ff;
      text-shadow: 0 0 8px #00f0ff;
    }
    .container {
      max-width: 900px;
      margin: 100px auto 40px;
      padding: 0 20px;
    }
    .glass-card {
      background: rgba(10, 16, 30, 0.65);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(0, 240, 255, 0.25);
      border-radius: 16px;
      padding: 30px;
      margin-bottom: 30px;
      box-shadow: 0 0 30px rgba(0, 240, 255, 0.1);
    }
    .owners-header {
      display: flex;
      gap: 15px;
      flex-wrap: wrap;
      margin-bottom: 20px;
    }
    .badge {
      padding: 8px 16px;
      border-radius: 30px;
      font-family: 'Orbitron', sans-serif;
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 1px;
    }
    .owner-badge {
      background: rgba(236, 72, 153, 0.15);
      color: #f472b6;
      border: 1px solid rgba(236, 72, 153, 0.4);
      box-shadow: 0 0 10px rgba(236, 72, 153, 0.2);
    }
    .coowner-badge {
      background: rgba(56, 189, 248, 0.15);
      color: #38bdf8;
      border: 1px solid rgba(56, 189, 248, 0.4);
      box-shadow: 0 0 10px rgba(56, 189, 248, 0.2);
    }
    h1, h2, h3 {
      font-family: 'Orbitron', sans-serif;
      color: #fff;
    }
    .user-profile img {
      width: 70px;
      height: 70px;
      border-radius: 50%;
      border: 2px solid #00f0ff;
      box-shadow: 0 0 15px #00f0ff;
    }
    .btn {
      display: inline-block;
      padding: 10px 24px;
      border-radius: 8px;
      text-decoration: none;
      font-family: 'Orbitron', sans-serif;
      font-size: 0.85rem;
      cursor: pointer;
      border: none;
      transition: all 0.3s;
    }
    .btn-login {
      background: #00f0ff;
      color: #000;
      box-shadow: 0 0 15px rgba(0, 240, 255, 0.4);
    }
    .btn-logout { background: #ef4444; color: #fff; }
    .btn-save { background: #10b981; color: #fff; margin-top: 10px; }
    .btn:hover { transform: scale(1.03); }
    textarea {
      width: 100%;
      height: 110px;
      background: rgba(0, 0, 0, 0.7);
      border: 1px solid #00f0ff;
      color: #00f0ff;
      padding: 12px;
      border-radius: 8px;
      font-family: 'Rajdhani', monospace;
      font-size: 1rem;
    }
  </style>
</head>
<body>

  <!-- 3D Canvas Background -->
  <div id="canvas-container"></div>

  <nav>
    <div class="logo">&lt;SPACE_TECH_HUB /&gt;</div>
    <div class="nav-links">
      <a href="#home">Home</a>
      <a href="#about">Mission</a>
      <% if (isAdmin) { %><a href="#admin">Admin Control</a><% } %>
    </div>
  </nav>

  <div class="container">
    
    <!-- Hero / Owner Section -->
    <section id="home" class="glass-card">
      <div class="owners-header">
        <div class="badge owner-badge">👑 OWNER: DISHA RANA</div>
        <div class="badge coowner-badge">⚡ CO-OWNER: AYUSH RANA</div>
      </div>
      
      <h1 style="font-size: 1.8rem; margin-bottom: 10px;">3D Orbital Command Center</h1>
      <p style="color: #94a3b8; margin-bottom: 20px;">Welcome to the Next-Gen Advanced Tech Platform.</p>
      
      <% if (user) { %>
        <div style="display: flex; align-items: center; gap: 20px;">
          <% if (user.photos && user.photos[0]) { %>
            <img src="<%= user.photos[0].value %>" alt="Profile" style="border-radius: 50%; width: 60px; height: 60px;">
          <% } %>
          <div>
            <h3>Welcome, <%= user.displayName %></h3>
            <p style="color: #10b981;">● Security Clearance Granted</p>
            <a href="/logout" class="btn btn-logout" style="margin-top: 8px;">Disconnect Session</a>
          </div>
        </div>
      <% } else { %>
        <p style="margin-bottom: 15px; color: #94a3b8;">Authenticate via Google OAuth to access secure terminal.</p>
        <a href="/auth/google" class="btn btn-login">System Login</a>
      <% } %>
    </section>

    <!-- Admin Panel -->
    <% if (isAdmin) { %>
      <section id="admin" class="glass-card" style="border-color: #f472b6;">
        <h3 style="color: #f472b6;">⚡ Core System Console (Admin Access)</h3>
        <p style="color: #94a3b8; font-size: 0.9rem; margin-bottom: 10px;">Direct live feed update protocol:</p>
        <form action="/update" method="POST">
          <textarea name="newContent"><%= content %></textarea>
          <button type="submit" class="btn btn-save">Transmit Update</button>
        </form>
      </section>
    <% } %>

    <!-- Dynamic Content Broadcast -->
    <section id="about" class="glass-card">
      <h3>📡 Live Orbital Broadcast</h3>
      <div style="background: rgba(0, 0, 0, 0.6); padding: 15px; border-radius: 8px; border-left: 3px solid #00f0ff; color: #00f0ff; font-size: 1.1rem; margin-top: 10px;">
        <%= content %>
      </div>
    </section>

  </div>

  <!-- Three.js 3D Earth Script -->
  <script>
    const container = document.getElementById('canvas-container');
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });

    renderer.setSize(window.innerWidth, window.innerHeight);
    container.appendChild(renderer.domElement);

    // Earth Geometry & Material
    const geometry = new THREE.SphereGeometry(2, 64, 64);
    const textureLoader = new THREE.TextureLoader();
    
    // Wireframe / Cyber Earth Look
    const material = new THREE.MeshBasicMaterial({
      color: 0x00f0ff,
      wireframe: true,
      transparent: true,
      opacity: 0.4
    });
    const earth = new THREE.Mesh(geometry, material);
    scene.add(earth);

    // Inner Solid Sphere
    const innerGeo = new THREE.SphereGeometry(1.98, 32, 32);
    const innerMat = new THREE.MeshBasicMaterial({ color: 0x020813 });
    const innerEarth = new THREE.Mesh(innerGeo, innerMat);
    scene.add(innerEarth);

    // 3D Particles / Starfield
    const starsGeo = new THREE.BufferGeometry();
    const starsCount = 800;
    const posArray = new Float32Array(starsCount * 3);

    for(let i=0; i<starsCount*3; i++) {
      posArray[i] = (Math.random() - 0.5) * 15;
    }
    starsGeo.setAttribute('position', new THREE.BufferAttribute(posArray, 3));
    const starsMat = new THREE.PointsMaterial({ size: 0.02, color: 0xffffff });
    const starMesh = new THREE.Points(starsGeo, starsMat);
    scene.add(starMesh);

    camera.position.z = 4.5;

    // Animation Loop
    function animate() {
      requestAnimationFrame(animate);
      earth.rotation.y += 0.003;
      earth.rotation.x += 0.001;
      starMesh.rotation.y -= 0.0005;
      renderer.render(scene, camera);
    }
    animate();

    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });
  </script>
</body>
</html>
