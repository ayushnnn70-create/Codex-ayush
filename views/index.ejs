<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quantum Universe | Disha Rana & Ayush Rana</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-dark: #05070d;
      --card-bg: rgba(13, 18, 30, 0.75);
      --border-color: rgba(255, 255, 255, 0.08);
      --accent-cyan: #38bdf8;
      --accent-pink: #f472b6;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: var(--bg-dark);
      color: var(--text-main);
      overflow-x: hidden;
      line-height: 1.6;
    }

    #space-canvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      z-index: -1;
      pointer-events: none;
    }

    /* Ambient Schrödinger Equation Overlay */
    .schrodinger-bg {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-family: 'Fira Code', monospace;
      font-size: clamp(2rem, 8vw, 6rem);
      font-weight: 700;
      color: rgba(56, 189, 248, 0.03);
      white-space: nowrap;
      user-select: none;
      z-index: -1;
      letter-spacing: 4px;
    }

    nav {
      position: fixed;
      top: 0;
      width: 100%;
      background: rgba(5, 7, 13, 0.85);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border-color);
      padding: 18px 5%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 1000;
    }

    .brand-logo {
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: 1.1rem;
      letter-spacing: 2px;
      color: var(--text-main);
      text-transform: uppercase;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .brand-logo::before {
      content: '';
      width: 8px;
      height: 8px;
      background: var(--accent-cyan);
      border-radius: 50%;
      box-shadow: 0 0 10px var(--accent-cyan);
    }

    .nav-links {
      display: flex;
      gap: 30px;
    }

    .nav-links a {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 500;
      transition: color 0.3s;
    }

    .nav-links a:hover {
      color: var(--text-main);
    }

    .container {
      max-width: 1050px;
      margin: 120px auto 60px;
      padding: 0 24px;
    }

    .glass-card {
      background: var(--card-bg);
      backdrop-filter: blur(20px);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 36px;
      margin-bottom: 32px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    }

    .meta-pills {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 24px;
    }

    .pill {
      display: inline-flex;
      align-items: center;
      padding: 6px 14px;
      border-radius: 20px;
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.5px;
    }

    .pill-owner {
      background: rgba(244, 114, 182, 0.1);
      color: var(--accent-pink);
      border: 1px solid rgba(244, 114, 182, 0.25);
    }

    .pill-coowner {
      background: rgba(56, 189, 248, 0.1);
      color: var(--accent-cyan);
      border: 1px solid rgba(56, 189, 248, 0.25);
    }

    h1 {
      font-family: 'Space Grotesk', sans-serif;
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 700;
      letter-spacing: -1px;
      margin-bottom: 12px;
      line-height: 1.2;
    }

    .subtitle {
      color: var(--text-muted);
      font-size: 1rem;
      margin-bottom: 28px;
    }

    .user-profile {
      display: flex;
      align-items: center;
      gap: 16px;
      padding-top: 10px;
    }

    .user-profile img {
      width: 54px;
      height: 54px;
      border-radius: 50%;
      border: 1px solid var(--accent-cyan);
      object-fit: cover;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 10px 22px;
      border-radius: 8px;
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.85rem;
      font-weight: 600;
      text-decoration: none;
      cursor: pointer;
      border: none;
      transition: all 0.2s ease;
    }

    .btn-primary {
      background: var(--text-main);
      color: var(--bg-dark);
    }

    .btn-primary:hover {
      background: #e2e8f0;
      transform: translateY(-1px);
    }

    .btn-danger {
      background: rgba(239, 68, 68, 0.15);
      color: #f87171;
      border: 1px solid rgba(239, 68, 68, 0.3);
    }

    .btn-save {
      background: var(--accent-cyan);
      color: var(--bg-dark);
      margin-top: 12px;
    }

    textarea {
      width: 100%;
      height: 110px;
      background: rgba(5, 7, 13, 0.8);
      border: 1px solid var(--border-color);
      color: var(--text-main);
      padding: 14px;
      border-radius: 8px;
      font-family: 'Fira Code', monospace;
      font-size: 0.9rem;
      outline: none;
    }

    textarea:focus {
      border-color: var(--accent-cyan);
    }

    /* Contact Section */
    .contact-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
      margin-top: 20px;
    }

    .contact-card {
      background: rgba(5, 7, 13, 0.6);
      border: 1px solid var(--border-color);
      padding: 20px;
      border-radius: 12px;
    }

    .contact-card h4 {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.85rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 8px;
    }

    .contact-card p {
      font-size: 0.95rem;
      color: var(--text-main);
      font-weight: 500;
    }

    footer {
      border-top: 1px solid var(--border-color);
      padding: 30px 0;
      text-align: center;
      color: var(--text-muted);
      font-size: 0.85rem;
    }
  </style>
</head>
<body>

  <!-- Schrödinger Equation BG -->
  <div class="schrodinger-bg">iℏ ∂/∂t Ψ(r,t) = Ĥ Ψ(r,t)</div>

  <!-- Space Canvas Background -->
  <canvas id="space-canvas"></canvas>

  <nav>
    <div class="brand-logo">Quantum Engine</div>
    <div class="nav-links">
      <a href="#overview">Overview</a>
      <a href="#broadcast">Broadcast</a>
      <% if (isAdmin) { %><a href="#admin">Admin Area</a><% } %>
      <a href="#contact">Contact Us</a>
    </div>
  </nav>

  <div class="container">
    
    <!-- Hero / Metadata Section -->
    <section id="overview" class="glass-card">
      <div class="meta-pills">
        <span class="pill pill-owner">OWNER: DISHA RANA</span>
        <span class="pill pill-coowner">CO-OWNER: AYUSH RANA</span>
      </div>

      <h1>Deep Space & Quantum Hub</h1>
      <p class="subtitle">An advanced Web App infrastructure for live telemetry and data broadcasting.</p>

      <% if (user) { %>
        <div class="user-profile">
          <% if (user.photos && user.photos[0]) { %>
            <img src="<%= user.photos[0].value %>" alt="Profile">
          <% } %>
          <div>
            <h3 style="font-size: 1.05rem;"><%= user.displayName %></h3>
            <p style="color: #34d399; font-size: 0.85rem;">● Authenticated Session</p>
            <a href="/logout" class="btn btn-danger" style="margin-top: 10px;">Disconnect</a>
          </div>
        </div>
      <% } else { %>
        <a href="/auth/google" class="btn btn-primary">Sign in with Google</a>
      <% } %>
    </section>

    <!-- Admin Panel (Admin Only) -->
    <% if (isAdmin) { %>
      <section id="admin" class="glass-card" style="border-color: rgba(56, 189, 248, 0.3);">
        <h3 style="font-family: 'Space Grotesk', sans-serif; font-size: 1.1rem; margin-bottom: 8px;">⚡ Live Control Panel</h3>
        <p class="subtitle" style="margin-bottom: 14px; font-size: 0.85rem;">Update public broadcast state below:</p>
        <form action="/update" method="POST">
          <textarea name="newContent"><%= content %></textarea>
          <button type="submit" class="btn btn-save">Publish Stream</button>
        </form>
      </section>
    <% } %>

    <!-- Broadcast Section -->
    <section id="broadcast" class="glass-card">
      <h3 style="font-family: 'Space Grotesk', sans-serif; font-size: 1.1rem; margin-bottom: 12px;">📡 Live Announcement</h3>
      <div style="background: rgba(5, 7, 13, 0.7); padding: 18px; border-radius: 8px; border-left: 2px solid var(--accent-cyan); font-family: 'Fira Code', monospace; font-size: 0.95rem; color: var(--accent-cyan);">
        <%= content %>
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="glass-card">
      <h3 style="font-family: 'Space Grotesk', sans-serif; font-size: 1.1rem; margin-bottom: 6px;">Contact Us</h3>
      <p class="subtitle" style="margin-bottom: 16px; font-size: 0.85rem;">Reach out to the executive management team.</p>

      <div class="contact-grid">
        <div class="contact-card">
          <h4>Owner Contact</h4>
          <p>Disha Rana</p>
        </div>
        <div class="contact-card">
          <h4>Co-Owner Contact</h4>
          <p>Ayush Rana</p>
        </div>
        <div class="contact-card">
          <h4>Official Admin</h4>
          <p>zuxislive@gmail.com</p>
        </div>
      </div>
    </section>

    <footer>
      Designed & Maintained by Disha Rana & Ayush Rana © 2026
    </footer>

  </div>

  <!-- Particle Background Engine -->
  <script>
    const canvas = document.getElementById('space-canvas');
    const ctx = canvas.getContext('2d');

    function resizeCanvas() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);

    const particles = Array.from({ length: 90 }, () => ({
      x: Math.random() * canvas.width,
      y: Math.random() * canvas.height,
      radius: Math.random() * 1.5 + 0.5,
      vx: (Math.random() - 0.5) * 0.2,
      vy: (Math.random() - 0.5) * 0.2,
      alpha: Math.random() * 0.6 + 0.2
    }));

    function animate() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      
      particles.forEach(p => {
        p.x += p.vx;
        p.y += p.vy;

        if (p.x < 0) p.x = canvas.width;
        if (p.x > canvas.width) p.x = 0;
        if (p.y < 0) p.y = canvas.height;
        if (p.y > canvas.height) p.y = 0;

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(255, 255, 255, ${p.alpha})`;
        ctx.fill();
      });

      requestAnimationFrame(animate);
    }
    animate();
  </script>
</body>
</html>
