.knowledge-card:hover { border-color: rgba(115, 217, 255, 0.4); }
.card-head { display: flex; align-items: center; gap: 18px; padding: 22px; cursor: pointer; background: rgba(255,255,255,.02); user-select: none; }
.section-no { font: 800 13px Manrope; color: var(--cyan); background: rgba(115, 217, 255, 0.12); padding: 6px 12px; border-radius: 4px; border: 1px solid rgba(115,217,255,.2); }
